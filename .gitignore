.DS_Store
.claude
.vscode

# decode outputs (large, reproducible from m4a)
data/wav/
figures/*
# keep the one interference evidence figure referenced by the protocol / CLAUDE.md
# (ignore figures/ CONTENTS, not the dir itself, so this negation can re-include it)
!figures/interference_analysis.png

# generated coarse seeds (reproducible via `python src/export_seeds.py`);
# human-reviewed ground-truth labels/<name>.csv are NOT ignored
labels/*.seed.csv
# verify outputs (reproducible via `python src/verify.py`); the COMMITTED
# adjudication queue labels/<name>.verify-review.csv is NOT ignored
labels/*.verified.csv

# python
__pycache__/
.ipynb_checkpoints/
my_documents/

# cut outputs (large, reproducible via `python src/cut.py` from committed labels/*.cuts.csv)
data/segments/

# new-batch source audio (~430 MB; input data, kept out of git history to avoid bloat —
# the small annotation source "Click Record SheetRecords.xlsx" IS committed. Track audio
# anyway with `git add -f "new audio/<file>.m4a"` if you decide to.)
new audio/

.claude
